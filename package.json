{
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "description": "Chrome extension that generates a one-page account brief for any company website.",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "happy-dom": "^21.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0",
    "wxt": "^0.21.0"
  },
  "name": "prospect-brief",
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "format": "prettier --write .",
